      {
        "id": "code-store",
        "name": "Reading speichern",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          620,
          300
        ],
        "parameters": {
          "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst body = $input.first().json.body || {};\nconst temp = Number(body.temp);\nconst hum  = Number(body.hum);\nconst tilt = body.tilt !== undefined ? Number(body.tilt) : null;\nif (!Number.isFinite(temp) || !Number.isFinite(hum)) {\n  return [{json: {ok: false, error: 'temp/hum fehlt oder ungueltig'}}];\n}\nstaticData.lastReading = {temp, hum, tilt: Number.isFinite(tilt) ? tilt : null, ts: new Date().toISOString()};\nreturn [{json: {ok: true}}];"
        }
      },
      {
        "id": "respond-data",
        "name": "Respond: Sensordaten",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1,
        "position": [
          840,
          300
        ],
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ JSON.stringify($json) }}",
